---
import "../styles.css";
import { listPlans } from "../lib/queries";

const plans = listPlans();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Degree planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Degree planner</a>
      <a href="/readme/">About</a>
      <a href="/admin">Admin</a>
    </nav>
    <main>
      <h1>Degree planner</h1>
      <p><a href="/plans/new">Start a new plan</a></p>

      {
        plans.length === 0 ? (
          <p>No plans yet.</p>
        ) : (
          <ul class="plan-list">
            {plans.map((plan) => (
              <li>
                <a href={`/plans/${plan.id}`}>{plan.label}</a>
                {` — ${plan.degreeTitle}, enrolled ${plan.enrollmentYear}`}
                {plan.specialisationTitle ? ` — ${plan.specialisationTitle}` : ""}
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
