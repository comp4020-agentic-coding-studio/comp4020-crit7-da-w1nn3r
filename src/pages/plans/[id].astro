---
import { courseWarnings, describeWarning, missingCompulsory } from "../../lib/planning";
import { getPlanDetail, listCourses, listPlanCourses } from "../../lib/queries";
import { SESSION_LABELS, SESSION_ORDER } from "../../lib/schema";
import "../../styles.css";

const id = Number(Astro.params.id);
const plan = Number.isInteger(id) ? getPlanDetail(id) : undefined;

if (!plan) {
  return Astro.redirect("/", 302);
}

const plannedCourses = listPlanCourses(plan.id);
const allCourses = listCourses();
const courseById = new Map(allCourses.map((course) => [course.id, course]));
const addableCourses = allCourses.filter(
  (course) => !course.retired && !plannedCourses.some((row) => row.courseId === course.id),
);
const missing = missingCompulsory(plan, plannedCourses);
const warningsByRow = new Map(plannedCourses.map((row) => [row.id, courseWarnings(row, plannedCourses)]));

// Always show at least 3 years, and one more than the furthest-planned year
// so there's always room to add the next one — no separate "add a year" step.
const furthestYear = plannedCourses.reduce((max, row) => Math.max(max, row.year), 0);
const yearCount = Math.max(3, furthestYear + 1);
const years = Array.from({ length: yearCount }, (_, i) => i + 1);

const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "duplicate"
    ? "That course is already in this plan."
    : error === "invalid"
      ? "That course, year or session wasn't valid."
      : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plan.label} — Degree planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Degree planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main class="plan-main">
      <h1>{plan.label}</h1>
      <p>
        {`${plan.degree.title} (${plan.degree.code}) — enrolled ${plan.enrollmentYear}`}
        {plan.specialisation ? ` — ${plan.specialisation.title} (${plan.specialisation.kind})` : ""}
      </p>

      {errorMessage && (
        <p role="alert" class="notice">
          {errorMessage}
        </p>
      )}

      {missing.length > 0 && (
        <div class="notice" role="status">
          <p>Add these before your plan meets its requirements (nothing here is enforced — it's a checklist):</p>
          <ul>
            {missing.map((item) =>
              item.kind === "required" ? (
                <li>
                  {courseById.get(item.courseId)?.code} — {courseById.get(item.courseId)?.title}
                </li>
              ) : (
                <li>
                  {item.poolLabel}: {item.plannedCount} of {item.poolMinCount} selected — choose from{" "}
                  {item.courseIds
                    .map((courseId) => courseById.get(courseId)?.code)
                    .filter(Boolean)
                    .join(", ")}
                </li>
              ),
            )}
          </ul>
        </div>
      )}

      <div class="grid-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Year</th>
              {SESSION_ORDER.map((session) => (
                <th scope="col">{SESSION_LABELS[session]}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {years.map((year) => (
              <tr>
                <th scope="row">Year {year}</th>
                {SESSION_ORDER.map((session) => {
                  const cellCourses = plannedCourses.filter(
                    (row) => row.year === year && row.session === session,
                  );
                  return (
                    <td>
                      {cellCourses.length > 0 && (
                        <ul class="cell-courses">
                          {cellCourses.map((row) => {
                            const warnings = warningsByRow.get(row.id) ?? [];
                            return (
                              <li>
                                <div class="cell-course-row">
                                  <span>
                                    {row.course.code} — {row.course.title}
                                  </span>
                                  <form method="post" action={`/api/plans/${plan.id}/courses/${row.id}`}>
                                    <button
                                      type="submit"
                                      aria-label={`Remove ${row.course.code} from Year ${year}, ${SESSION_LABELS[session]}`}
                                    >
                                      Remove
                                    </button>
                                  </form>
                                </div>
                                {warnings.length > 0 && (
                                  <ul class="warnings">
                                    {warnings.map((warning) => (
                                      <li class="warning">{describeWarning(warning, courseById)}</li>
                                    ))}
                                  </ul>
                                )}
                              </li>
                            );
                          })}
                        </ul>
                      )}
                      {addableCourses.length > 0 && (
                        <form method="post" action={`/api/plans/${plan.id}/courses`} class="add-course">
                          <input type="hidden" name="year" value={year} />
                          <input type="hidden" name="session" value={session} />
                          <select
                            name="courseId"
                            required
                            aria-label={`Add a course to Year ${year}, ${SESSION_LABELS[session]}`}
                          >
                            <option value="">Add a course…</option>
                            {addableCourses.map((course) => (
                              <option value={course.id}>
                                {course.code} — {course.title}
                              </option>
                            ))}
                          </select>
                          <button type="submit">Add</button>
                        </form>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
