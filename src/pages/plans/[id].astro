---
import PlanCell from "../../components/PlanCell.astro";
import { courseWarnings, missingCompulsory } from "../../lib/planning";
import { getPlanDetail, listCourses, listPlanCourses } from "../../lib/queries";
import { SESSION_LABELS, type Session } from "../../lib/schema";
import "../../styles.css";

// ANU runs primarily on Semester 1 and 2 — everything else gets a smaller,
// collapsed table below rather than six equally-wide columns.
const PRIMARY_SESSIONS: Session[] = ["s1", "s2"];
const SECONDARY_SESSIONS: Session[] = ["summer", "autumn", "winter", "spring"];

const id = Number(Astro.params.id);
const plan = Number.isInteger(id) ? getPlanDetail(id) : undefined;

if (!plan) {
  return Astro.redirect("/", 302);
}

const plannedCourses = listPlanCourses(plan.id);
const allCourses = listCourses();
const courseById = new Map(allCourses.map((course) => [course.id, course]));
const addableCourses = allCourses.filter(
  (course) => !course.retired && !plannedCourses.some((row) => row.courseId === course.id),
);
const missing = missingCompulsory(plan, plannedCourses);
const warningsByRow = new Map(plannedCourses.map((row) => [row.id, courseWarnings(row, plannedCourses)]));

// Always show at least 3 years, and one more than the furthest-planned year
// so there's always room to add the next one — no separate "add a year" step.
const furthestYear = plannedCourses.reduce((max, row) => Math.max(max, row.year), 0);
const yearCount = Math.max(3, furthestYear + 1);
const years = Array.from({ length: yearCount }, (_, i) => i + 1);

const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "duplicate"
    ? "That course is already in this plan."
    : error === "invalid"
      ? "That course, year or session wasn't valid."
      : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plan.label} — Degree planner</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Degree planner</a>
      <a href="/readme/">About</a>
    </nav>
    <main class="plan-main">
      <h1>{plan.label}</h1>
      <p>
        {`${plan.degree.title} (${plan.degree.code}) — enrolled ${plan.enrollmentYear}`}
        {plan.specialisation ? ` — ${plan.specialisation.title} (${plan.specialisation.kind})` : ""}
      </p>
      <p class="load-note">
        Recommended full-time load: 4 courses in Semester 1 and Semester 2, 1 in other sessions — a guide, not a
        requirement.
      </p>

      {errorMessage && (
        <p role="alert" class="notice">
          {errorMessage}
        </p>
      )}

      {missing.length > 0 && (
        <div class="notice" role="status">
          <p>Add these before your plan meets its requirements (nothing here is enforced — it's a checklist):</p>
          <ul>
            {missing.map((item) =>
              item.kind === "required" ? (
                <li>
                  {courseById.get(item.courseId)?.code} — {courseById.get(item.courseId)?.title}
                </li>
              ) : (
                <li>
                  {item.poolLabel}: {item.plannedCount} of {item.poolMinCount} selected — choose from{" "}
                  {item.courseIds
                    .map((courseId) => courseById.get(courseId)?.code)
                    .filter(Boolean)
                    .join(", ")}
                </li>
              ),
            )}
          </ul>
        </div>
      )}

      <div class="grid-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Year</th>
              {PRIMARY_SESSIONS.map((session) => (
                <th scope="col">{SESSION_LABELS[session]}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {years.map((year) => (
              <tr>
                <th scope="row">Year {year}</th>
                {PRIMARY_SESSIONS.map((session) => (
                  <PlanCell
                    planId={plan.id}
                    year={year}
                    session={session}
                    plannedCourses={plannedCourses}
                    warningsByRow={warningsByRow}
                    courseById={courseById}
                    addableCourses={addableCourses}
                  />
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <details class="other-sessions" open={plannedCourses.some((row) => SECONDARY_SESSIONS.includes(row.session))}>
        <summary>Other sessions — Summer, Autumn, Winter, Spring</summary>
        <div class="grid-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Year</th>
                {SECONDARY_SESSIONS.map((session) => (
                  <th scope="col">{SESSION_LABELS[session]}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {years.map((year) => (
                <tr>
                  <th scope="row">Year {year}</th>
                  {SECONDARY_SESSIONS.map((session) => (
                    <PlanCell
                      planId={plan.id}
                      year={year}
                      session={session}
                      plannedCourses={plannedCourses}
                      warningsByRow={warningsByRow}
                      courseById={courseById}
                      addableCourses={addableCourses}
                    />
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </main>
  </body>
</html>
