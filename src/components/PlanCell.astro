---
import { describeWarning, RECOMMENDED_COURSE_LOAD, type CourseWarning } from "../lib/planning";
import type { PlanCourseDetail } from "../lib/queries";
import { SESSION_LABELS, type Course, type Session } from "../lib/schema";

interface Props {
  planId: number;
  year: number;
  session: Session;
  plannedCourses: PlanCourseDetail[];
  warningsByRow: Map<number, CourseWarning[]>;
  courseById: Map<number, Course>;
  addableCourses: Course[];
}

const { planId, year, session, plannedCourses, warningsByRow, courseById, addableCourses } = Astro.props;

const cellCourses = plannedCourses.filter((row) => row.year === year && row.session === session);
const recommended = RECOMMENDED_COURSE_LOAD[session];
---

<td>
  {
    cellCourses.length > 0 && (
      <ul class="cell-courses">
        {cellCourses.map((row) => {
          const warnings = warningsByRow.get(row.id) ?? [];
          return (
            <li>
              <div class="cell-course-row">
                <span>
                  {row.course.code} — {row.course.title}
                </span>
                <form method="post" action={`/api/plans/${planId}/courses/${row.id}`}>
                  <button
                    type="submit"
                    aria-label={`Remove ${row.course.code} from Year ${year}, ${SESSION_LABELS[session]}`}
                  >
                    Remove
                  </button>
                </form>
              </div>
              {warnings.length > 0 && (
                <ul class="warnings">
                  {warnings.map((warning) => (
                    <li class="warning">{describeWarning(warning, courseById)}</li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    )
  }
  <p class="load-hint">
    {cellCourses.length} of {recommended} typical
  </p>
  {
    addableCourses.length > 0 && (
      <form method="post" action={`/api/plans/${planId}/courses`} class={cellCourses.length > 0 ? "add-course has-divider" : "add-course"}>
        <input type="hidden" name="year" value={year} />
        <input type="hidden" name="session" value={session} />
        <select name="courseId" required aria-label={`Add a course to Year ${year}, ${SESSION_LABELS[session]}`}>
          <option value="">Add a course…</option>
          {addableCourses.map((course) => (
            <option value={course.id}>
              {course.code} — {course.title}
            </option>
          ))}
        </select>
        <button type="submit">Add</button>
      </form>
    )
  }
</td>
